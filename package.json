{
  "name": "prisma-launcher-agent",
  "version": "0.1.0",
  "description": "Agente de busca ultrarrápida do PRISMA — atalho global, favoritos e links direto do PC",
  "main": "main.js",
  "author": "PageUp Sistemas",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/pgup-sistemas/prisma-launcher.git"
  },
  "homepage": "https://github.com/pgup-sistemas/prisma-launcher",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.pageupsistemas.prisma.launcher",
    "productName": "PRISMA Launcher",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
